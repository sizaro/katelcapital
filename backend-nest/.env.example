NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://katel:katel_dev_password@localhost:5435/katel_capital?schema=public
REDIS_URL=redis://localhost:6381
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
SEED_SUPER_ADMIN_EMAIL=admin@katel.local
SEED_SUPER_ADMIN_PASSWORD=replace-for-local-development
# Optional production reviewers for BYU proof decisions. Both values are
# required for each account; leave both blank to omit that account.
SEED_ACADEMY_MANAGER_EMAIL=
SEED_ACADEMY_MANAGER_PASSWORD=
SEED_VETTING_OFFICER_EMAIL=
SEED_VETTING_OFFICER_PASSWORD=
SEED_DEMO_PASSWORD=optional-shared-local-password-only
# Development: http://localhost:5174. Production: your deployed Vercel URL,
# e.g. https://academy.your-domain.com (no trailing slash).
APP_PUBLIC_URL=http://localhost:5174
PAYMENT_MODE=mock

# Gmail SMTP (use a Gmail App Password, not your normal Google password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Katel Academy <your-gmail-address@gmail.com>"

# Cloudinary is required before BYU Pathway proof uploads can be used.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
